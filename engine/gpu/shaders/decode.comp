    145, 153, 177, 185, 209, 217, 241, 249, 147, 155, 179, 187, 211, 219, 243, 251,
    149, 157, 181, 189, 213, 221, 245, 253, 151, 159, 183, 191, 215, 223, 247, 255);

const uint kMask = (4u << 20) - 1u;

uint Page(uint ppr, uint px, uint py) { return p.tbp + 32u * (py * max(ppr, 1u) + px); }

uint Byte(uint a) { return (mem[a >> 2] >> ((a & 3u) * 8u)) & 0xFFu; }

// The texel at (x, y), raw, as the format stores it.
uint Raw(uint x, uint y) {
    const uint psm = p.psm;
    if (psm == PSMT8) {
        const uint block = Page(p.tbw / 2u, x / 128u, y / 64u) + kBlock32[((y % 64u) / 16u) * 8u + (x % 128u) / 16u];
        const uint row = y % 16u;
        return Byte((block * 256u + kColumn8[(row % 8u) * 16u + x % 16u] + (row >= 8u ? 128u : 0u)) & kMask);
    }
    if (psm == PSMT4) {
        const uint block = Page(p.tbw / 2u, x / 128u, y / 128u) + kBlock16[((y % 128u) / 16u) * 4u + (x % 128u) / 32u];
        const uint row = y % 16u;
        const uint index = kColumn4[(row % 8u) * 32u + x % 32u] + (row >= 8u ? 256u : 0u);
        const uint b = Byte((block * 256u + index / 2u) & kMask);
        return (index & 1u) != 0u ? b >> 4 : b & 15u;
    }
    if (psm == PSMCT16 || psm == PSMCT16S || psm == PSMZ16 || psm == PSMZ16S) {
        const uint i = ((y % 64u) / 8u) * 4u + (x % 64u) / 16u;
        uint b;
        if (psm == PSMCT16) b = kBlock16[i];
        else if (psm == PSMCT16S) b = kBlock16S[i];
        else if (psm == PSMZ16) b = kBlockZ16[i];
        else b = kBlockZ16S[i];
        const uint a = ((Page(p.tbw, x / 64u, y / 64u) + b) * 256u + kColumn16[(y % 8u) * 16u + x % 16u] * 2u) & kMask;
        return (mem[a >> 2] >> ((a & 2u) * 8u)) & 0xFFFFu;
    }
    // The 32-bit layouts: CT32, CT24, Z32, Z24, and T8H/T4HL/T4HH in CT32's top byte.
    const uint i = ((y % 32u) / 8u) * 8u + (x % 64u) / 8u;
    const uint b = (psm == PSMZ32 || psm == PSMZ24) ? kBlockZ32[i] : kBlock32[i];
    const uint a = ((Page(p.tbw, x / 64u, y / 32u) + b) * 256u + kColumn32[(y % 8u) * 8u + x % 8u] * 4u) & kMask;
    const uint w = mem[a >> 2];
    if (psm == PSMT8H) return w >> 24;
    if (psm == PSMT4HL) return (w >> 24) & 15u;
    if (psm == PSMT4HH) return w >> 28;
    return w;
}

uint Wrap(int i, uint size, uint mode, uint lo, uint hi) {
    if (mode == 0u) return uint(i) & (size - 1u);
    if (mode == 1u) return uint(clamp(i, 0, int(size) - 1));
    if (mode == 2u) return uint(clamp(i, int(lo), int(hi)));
    return (uint(i) & lo) | hi;
}

// A texel as the GS expands it: TEXA for 24- and 16-bit texels, the CLUT for
// palettized ones.
uint Expand(uint raw) {
    const uint psm = p.psm;
    const uint ta0 = p.texa_lo & 0xFFu;
    const bool aem = (p.texa_lo & 0x8000u) != 0u;
    if (psm == PSMT8 || psm == PSMT8H) return clut[raw & 0xFFu];
    if (psm == PSMT4 || psm == PSMT4HL || psm == PSMT4HH) return clut[(p.csa * 16u + (raw & 15u)) & 0xFFu];
    if (psm == PSMCT24 || psm == PSMZ24) {
        const uint rgb = raw & 0xFFFFFFu;
        return rgb | ((aem && rgb == 0u) ? 0u : ta0) << 24;
    }
    if (psm == PSMCT16 || psm == PSMCT16S || psm == PSMZ16 || psm == PSMZ16S) {
        const uint a = (raw & 0x8000u) != 0u ? p.ta1 : ((aem && (raw & 0x7FFFu) == 0u) ? 0u : ta0);
        return ((raw & 31u) << 3) | (((raw >> 5) & 31u) << 11) | (((raw >> 10) & 31u) << 19) | (a << 24);
    }
    return raw;
}

// Mode 1: a CLUT load (TEX0's CLD), as the host's Gs::LoadClut does one, from
// the GPU's copy of local memory: tbp is CBP, tbw 1, psm CPSM (CT32, CT16,
// CT16S), tw the entries (256 for an 8-bit texture, 16 for a 4-bit one at
// CSA), CSM1's arrangement - an 8-bit CLUT a 16x16 image with index bits 3 and
// 4 swapped, a 4-bit one 8x2. 16-bit entries expand by TEXA as they load.
void LoadClut() {
    const uint i = gl_GlobalInvocationID.x;
    if (gl_GlobalInvocationID.y != 0u || i >= p.tw) return;
    const bool eight = p.tw == 256u;
    uint x, y;
    if (eight) {
        const uint q = (i & 0xE7u) | ((i & 0x08u) << 1) | ((i & 0x10u) >> 1);
        x = q % 16u;
        y = q / 16u;
    } else {
        x = i % 8u;
        y = i / 8u;
    }
    clut[eight ? i : (p.csa * 16u + i) % 256u] = Expand(Raw(x, y));
}

void main() {
    if (p.mode == 1u) {
        LoadClut();
        return;
    }
    const uint u = gl_GlobalInvocationID.x, v = gl_GlobalInvocationID.y;
    if (u >= p.tw || v >= p.th) return;
    const uint x = Wrap(int(u), p.tw, p.wms, p.minu, p.maxu) & 2047u;
    const uint y = Wrap(int(v), p.th, p.wmt, p.minv, p.maxv) & 2047u;
    lin[v * p.tw + u] = Expand(Raw(x, y));
}
