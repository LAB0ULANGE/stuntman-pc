--- a/games/stuntman/port/overrides.cpp
+++ b/games/stuntman/port/overrides.cpp
@@ -27,6 +27,8 @@ void F_002521E0(lifted::Context& c);
 void F_00252208(lifted::Context& c);
 void F_001D0DA0(lifted::Context& c);
 void F_001D4FA8(lifted::Context& c);
+void F_001D6008(lifted::Context& c);
+void F_001D6440(lifted::Context& c);
 
 namespace {
 
@@ -263,11 +265,40 @@ void PictureWait(lifted::Context& c) {
     F_001D4FA8(c);
 }
 
+// widescreen=on: the camera's aspect (0x001D4C88 sets 4/3 in $f23 and
+// passes it in $f13 to the projection, 0x001D6440, and to what it keeps of
+// the view, 0x001D6008 - nothing else calls them) made 16/9, and the
+// picture shown 16:9: the scene wider, as tall as before. The 2D (menus,
+// the stunt's gauges) is stretched with it.
+bool Widescreen() {
+    static const bool on = ps2host::SettingOn("widescreen", false);
+    return on;
+}
+void WidenAspect(lifted::Context& c) {
+    float aspect;
+    std::memcpy(&aspect, &c.f[13], 4);
+    aspect *= (16.0f / 9.0f) / (4.0f / 3.0f);
+    std::memcpy(&c.f[13], &aspect, 4);
+}
+void WideProjection(lifted::Context& c) {
+    static int told = 0;
+    if (told++ % 500 == 0) { float f12, f13; std::memcpy(&f12, &c.f[12], 4); std::memcpy(&f13, &c.f[13], 4);
+        std::fprintf(stderr, "[ws] projection f12 %g f13 %g a1 %llx a2 %llx\n", f12, f13, (unsigned long long)c.r[5], (unsigned long long)c.r[6]); }
+    if (Widescreen()) c.r[5] = 0x100;
+    F_001D6440(c);
+}
+void WideView(lifted::Context& c) {
+    F_001D6008(c);
+}
+
 }  // namespace
 
 void RegisterGameOverrides() {
     ps2host::Override(0x001D4FA8u, PictureWait, "the picture's wait: a picture every blank with frame_rate=50");
     ps2host::Override(0x001D0DA0u, LightTable, "the light table: shadows and ambient light from the PC settings");
+    ps2host::Override(0x001D6440u, WideProjection, "the projection: widescreen=on widens the camera's aspect to 16/9");
+    ps2host::Override(0x001D6008u, WideView, "the view kept: as wide as the projection with widescreen=on");
+    if (Widescreen()) ps2host::SetSetting("aspect", "16:9");
     // ps2host::Override(0x00123456u, SomeHook, "what it does and why");
 
     ps2host::Override(0x00253020u, GuestPrintf, "printf: the game's messages to the log as [guest] lines");
